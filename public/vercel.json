{
  "buildCommand": "node build-nav.js",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/$1"
    },
    {
      "source": "/_next/(.*)",
      "destination": "/_next/$1"
    },
    {
      "source": "/((?!api|app|_next|.*\\..*).*)",
      "destination": "/$1.html"
    }
  ]
}
